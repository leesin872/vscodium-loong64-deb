[Unit]
Description=Auto-package & publish VSCodium loong64 deb (daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 每 3600 秒检查一次上游；有新版本则自动打包并上传 GitHub Release
ExecStart=/opt/vscodium-loong64-deb/check-and-publish.sh --daemon 3600
Restart=always
RestartSec=60
WorkingDirectory=/opt/vscodium-loong64-deb
# 日志进 journald：journalctl -u codium-autodeb -f

[Install]
WantedBy=multi-user.target
